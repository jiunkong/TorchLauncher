{
  "name": "torchlauncher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable server-specific Minecraft launchers and an administrator studio.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.34.7 <11"
  },
  "scripts": {
    "dev:launcher": "pnpm --filter @torchlauncher/launcher dev",
    "dev:studio": "pnpm --filter @torchlauncher/studio dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "package:launcher": "pnpm --filter @torchlauncher/launcher package",
    "package:studio": "pnpm --filter @torchlauncher/studio package"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
